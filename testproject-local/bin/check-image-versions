#!/bin/bash
#
# This script dynamically parses '.env' to extract Docker image information,
# checks DockerHub for the latest versions,
# and compares them with current ones.
#
# The image URLs are automatically discovered from '# TAG: url' comments in the file.
#
# '# INFO: message'     comments add warnings to the output (like log levels).
# '# WARNING: message'  comments add warnings to the output.
# '# ERROR: message'    comments add errors to the output.
#
# For the description of CLI arguments, such as how to output JSON, run with script with '-h'.
#
DIR="$(dirname "$0")"

set -e
# exits on non-existing file thanks to '-e'
. "$DIR/../../lib/functions.bash"
. "$DIR/../../lib/version-functions.bash"
. "$DIR/../../lib/json-functions.bash"
# auto-run unit tests
. "$DIR/../../lib/version-functions-tests.bash"
set +e

#############################################################################
# file to parse - not configurable because all other scripts work with it too (via load_env_file)
INPUT_FILE="$DIR/../.env"

# when set to 1 by parse_args, results are printed as a JSON document on stdout
JSON_OUTPUT=""

# compact JSON objects (one per image), collected in JSON mode and assembled by emit_json_output
declare -a IMAGE_ROWS_JSON

readonly SLEEP_IF_TOO_MANY_REQUESTS=5s
readonly SLEEP_BETWEEN_IMAGE_REQUESTS=0.3s
readonly V_BORDER="│"

# Update types. For no update_label, print nothing - to reduce visual noise.
# For the same reason, use the same style for all update_label types (currently bold).
# The update type and the changed part of the latest version (see find_version_diff_start)
# are additionally highlighted with COLOR_HIGHLIGHT.
readonly UPDATE_NONE_LABEL=""
readonly UPDATE_NONE_COLOR=""
#
readonly UPDATE_MAJOR_LABEL="major"
readonly UPDATE_MAJOR_COLOR=$BOLD
#
readonly UPDATE_MINOR_LABEL="minor"
readonly UPDATE_MINOR_COLOR=$BOLD
#
readonly UPDATE_PATCH_LABEL="patch"
readonly UPDATE_PATCH_COLOR=$BOLD
#
readonly UPDATE_SPECIAL_LABEL="special"
readonly UPDATE_SPECIAL_COLOR=$BOLD

# table columns
readonly COL_NUM_LABEL="#"
readonly COL_NUM_WIDTH=2
#
readonly COL_IMAGE_LABEL="Docker Image"
readonly COL_IMAGE_WIDTH=32
#
readonly COL_LOCAL_LABEL="Local Version"
readonly COL_LOCAL_WIDTH=20
#
readonly COL_LATEST_LABEL="Latest Version"
readonly COL_LATEST_WIDTH=20
#
readonly COL_UPDATE_LABEL="Update"
# The longest value. No '<<<' because it adds a newline.
COL_UPDATE_WIDTH=$(echo -n "$UPDATE_SPECIAL_LABEL" | wc -m)

# grey (make notes dimmer than image metadata)
readonly NOTE_COLOR='\033[0;38;5;242m'
#############################################################################

#
# Prints usage information.
#
function print_usage() {
    echo "Usage: $0 [-j|--json] [-h|--help]]"
    echo
    echo "Checks DockerHub for newer versions of the Docker images listed in the given file."
    echo "  -j, --json          print results as a JSON document (logs go to stderr)"
    echo "  -h, --help          print this help and exit"
    echo
    echo "Sample JSON output:"
    cat <<EOF
{
  "images": [
    {
      "image": "test",
      "variable": "TEST_IMAGE_VERSION",
      "localVersion": "0.1.2",
      "latestVersion": "0.1.3",
      "updateType": "patch",
      "fetchFailed": false,
      "info": [
        "info message 1",
        "info message 2"
      ],
      "warnings": [
        "warning message"
      ],
      "errors": [
        "error message"
      ]
    }
  ]
}
EOF
}

#
# Parses CLI arguments using external 'getopt' (long options are not supported by builtin 'getopts').
# Sets global JSON_OUTPUT to non-empty when '--json' is requested.
#
# @param $@   CLI arguments (as passed to the script)
#
function parse_args() {
    local parsed
    if ! parsed=$(getopt -o jh -l json,help -n "$0" -- "$@"); then
        print_usage >&2
        exit 1
    fi

    eval set -- "$parsed"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -j | --json)
                JSON_OUTPUT=1
                shift
                ;;
            -h | --help)
                print_usage
                exit 0
                ;;
            --)
                shift
                break
                ;;
            *)
                print_usage >&2
                exit 1
                ;;
        esac
    done

    # positional arguments are not accepted
    if [[ $# -gt 0 ]]; then
        print_usage >&2
        exit 1
    fi
}

#
# Parses input file and builds global associative arrays of Docker image tags and infos.
# Only 'hub.docker.com' URLs are recognized.
#
# Sets global associative array IMAGES_MAP with keys as repository names and values
# as 'variable_name:version' pairs.
#
# Sets global associative array IMAGES_INFO_MAP with keys as repository names and values
# as infos (newline-separated).
#
# Sets global associative array IMAGES_WARNINGS_MAP with keys as repository names and values
# as warnings (newline-separated).
#
# Sets global associative array IMAGES_ERRORS_MAP with keys as repository names and values
# as errors (newline-separated).
#
# Example: IMAGES_MAP["redis"]="REDIS_VERSION:16.4"
#          IMAGES_MAP["confluentinc/cp-kafka"]="KAFKA_VERSION:8.0.1"
#          IMAGES_INFO_MAP["redis"]="This engine is fast"
#          IMAGES_WARNINGS_MAP["confluentinc/cp-kafka"]="Breaking changes in recent versions"
#          IMAGES_ERRORS_MAP["confluentinc/cp-kafka"]="This version has critical bugs"
#
# Captures '# INFO:', '# WARNING:', and '# ERROR:' comments that appear after TAG comments and before the image
# version assignment. This prevents misassociation of unrelated infos with Docker images. The comments are collected
# until a version variable is found, then associated with that image.
#
# @param $1   path to '.env' file to parse
#
function parse_input_file() {
    local -r env_file=${1?Missing env_file}

    # associative array to store repo:var:version
    declare -gA IMAGES_MAP
    # associative array to store repo:info messages
    declare -gA IMAGES_INFO_MAP
    # associative array to store repo:warning messages
    declare -gA IMAGES_WARNINGS_MAP
    # associative array to store repo:error messages
    declare -gA IMAGES_ERRORS_MAP

    local current_repo=""
    local current_var=""
    local current_version=""
    
    local current_infos=()
    local current_warnings=()
    local current_errors=()
    local line
    
    while IFS= read -r line || [[ -n "$line" ]]; do
        # skip empty lines
        [[ -z "$line" ]] && continue
        
        # check for TAG comment with DockerHub URL
        if [[ "$line" =~ ^#[[:space:]]*TAG:[[:space:]]*https://hub\.docker\.com/(.*)/tags[[:space:]]*$ ]]; then
            local url_path="${BASH_REMATCH[1]}"
            
            # extract repository from URL path, handle official images: _/mongo -> mongo.
            if [[ "$url_path" =~ ^_/([^/]+)$ ]]; then
                current_repo="${BASH_REMATCH[1]}"
            # handle repository images: r/username/repo -> username/repo
            elif [[ "$url_path" =~ ^r/([^/]+)/([^/]+)$ ]]; then
                current_repo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
            # unknown format - reset and skip
            else
                current_repo=""
                current_infos=()
                current_warnings=()
                current_errors=()
                continue
            fi
            
            # reset version info and infos for next iteration
            current_var=""
            current_version=""
            current_infos=()
            current_warnings=()
            current_errors=()
            continue
        fi
        
        # check for INFO comment (only after TAG comment)
        if [[ -n "$current_repo" && "$line" =~ ^#[[:space:]]*INFO:[[:space:]]*(.+)$ ]]; then
            local message="${BASH_REMATCH[1]}"

            if [[ "$message" =~ [^[:space:]] ]]; then
                current_infos+=("$message")
            fi

            continue
        fi
        
        # check for WARNING comment (only after TAG comment)
        if [[ -n "$current_repo" && "$line" =~ ^#[[:space:]]*WARNING:[[:space:]]*(.+)$ ]]; then
            local message="${BASH_REMATCH[1]}"

            if [[ "$message" =~ [^[:space:]] ]]; then
                current_warnings+=("$message")
            fi

            continue
        fi
        
        # check for ERROR comment (only after TAG comment)
        if [[ -n "$current_repo" && "$line" =~ ^#[[:space:]]*ERROR:[[:space:]]*(.+)$ ]]; then
            local message="${BASH_REMATCH[1]}"

            # not blank
            if [[ "$message" =~ [^[:space:]] ]]; then
                current_errors+=("$message")
            fi

            continue
        fi
        
        # if we have a repo from TAG comment, look for version variable
        if [[ -z "$current_repo" ]]; then
            continue
        fi

        # match variable assignment: VAR_NAME=version
        # (the variable name must start with a capital letter or underscore, but can contain digits too)
        if [[ "$line" =~ ^([A-Z_][A-Z_0-9]*)=([^[:space:]]+)[[:space:]]*$ ]]; then
            current_var="${BASH_REMATCH[1]}"
            current_version="${BASH_REMATCH[2]}"

            # post-process complete image metadata and notes
            if [[ -n "$current_var" && -n "$current_version" ]]; then
                IMAGES_MAP["$current_repo"]="$current_var:$current_version"

                # join infos with newline separator
                if [[ ${#current_infos[@]} -gt 0 ]]; then
                    local IFS=$'\n'
                    IMAGES_INFO_MAP["$current_repo"]="${current_infos[*]}"
                fi

                # join warnings with newline separator
                if [[ ${#current_warnings[@]} -gt 0 ]]; then
                    local IFS=$'\n'
                    IMAGES_WARNINGS_MAP["$current_repo"]="${current_warnings[*]}"
                fi

                # join errors with newline separator
                if [[ ${#current_errors[@]} -gt 0 ]]; then
                    local IFS=$'\n'
                    IMAGES_ERRORS_MAP["$current_repo"]="${current_errors[*]}"
                fi
            fi

            # reset for next iteration
            current_repo=""
            current_var=""
            current_version=""

            current_infos=()
            current_warnings=()
            current_errors=()
        fi
    done < "$env_file"
}

#
# Converts global associative array to indexed array for iteration.
# Populates the referenced array with "repo:variable:version" strings, sorted alphabetically by repository name.
# Example: DOCKER_IMAGES=("mongo?MONGO_VERSION:8.0.1" "postgres:POSTGRES_VERSION:16.4" "redis:REDIS_VERSION:8.0.1")
#
# @param $1   name of indexed array variable to populate (passed by reference)
#
function collect_docker_images() {
    local -n result_array=${1?Missing result_array}
    result_array=()
    
    # sort repository names (array keys)
    declare -a sorted_repos
    mapfile -t sorted_repos < <(printf '%s\n' "${!IMAGES_MAP[@]}" | sort)
    #echo "Sorted repos: ${sorted_repos[@]}" >&2

    for repo in "${sorted_repos[@]}"; do
        local var_version="${IMAGES_MAP[$repo]}"
        result_array+=("$repo:$var_version")
    done
}

#
# Checks if a version tag is valid for comparison. Namely, the version must have the same suffix.
# Example:
#   "1.2.3" ""                → 0 (true)
#   "v1.2.3-alpine" "-alpine" → 0 (true)
#   "2.8-jre17" "-jre17"      → 0 (true)
#   "pg18.4-ts2.29.0" ""      → 0 (true)
#   "pg18.4-ts2.29.0-all-oss" "all-oss" → 0 (true)
#   "pg18.4-ts2.29.0-all-oss" ""        → 1 (false, suffix mismatch)
#   "nightly" ""              → 1 (false, suffix mismatch)
#   "latest" ""               → 1 (false, suffix mismatch)
#   "1.2.3-alpine" ""         → 1 (false, suffix mismatch)
#
# @param $1   version tag to validate
# @param $2   current version suffix for matching (optional, empty string if none)
# @return (in $?): 0 (true) if version is valid, 1 (false) otherwise
#
function is_comparable_version() {
    local -r version=${1?Missing version}
    local -r current_suffix=${2?Missing current_suffix}
    
    # remove 'v' prefix for checking
    local -r check_version="${version#v}"

    # reject Windows containers (case-insensitive)
    if [[ "${check_version,,}" =~ windows ]]; then
        return 1
    fi
    
    # reject amd64 containers (case-insensitive)
    if [[ "${check_version,,}" =~ amd64 ]]; then
        return 1
    fi
    
    # reject arm containers (case-insensitive)
    if [[ "${check_version,,}" =~ arm ]]; then
        return 1
    fi
    
    # reject ppc containers (case-insensitive)
    if [[ "${check_version,,}" =~ ppc ]]; then
        return 1
    fi
    
    # reject pre-release versions (case-insensitive)
    if [[ "${check_version,,}" =~ (beta|alpha|rc) ]]; then
        return 1
    fi
    
    # check for standalone non-numeric tags (reject these)
    if [[ "$check_version" =~ ^(nightly|dev|alpine|noble|trixie|bullseye|bookworm|slim|latest|main|master|stable|testing|edge|demo|pre)$ ]]; then
        return 1
    fi
    
    # check for date-based versions (8 digits)
    if [[ "$check_version" =~ ^[0-9]{8}$ ]]; then
        return 0
    fi
    
    # check for simple numeric versions
    if [[ "$check_version" =~ ^[0-9]+$ ]]; then
        return 0
    fi
    
    # check for TimescaleDB format pg<PgVersion>-ts<TsVersion> with an optional suffix
    # (e.g. pg18.4-ts2.29.0 or pg17.10-ts2.28.2-all-oss): the PG and TS version parts are
    # compared (PG first, then TS) and never exact-matched, so candidates with a different
    # PG version are still comparable
    if [[ "$check_version" =~ ^pg[0-9]+(\.[0-9]+)*-ts[0-9]+(\.[0-9]+)*(-(.+))?$ ]]; then
        local -r tsdb_candidate_suffix="${BASH_REMATCH[4]}"

        # suffixes must match exactly so that variants like '-oss' and '-all-oss' don't get mixed up
        if [[ "$tsdb_candidate_suffix" == "$current_suffix" ]]; then
            return 0
        fi

        return 1
    fi
    
    # Check for semantic version patterns (must start with number).
    # Matches: 1.2.3, 1.2.3-alpine, 2.8-jre17.
    if [[ "$check_version" =~ ^[0-9] ]]; then
        # must contain at least one digit and valid characters
        if [[ "$check_version" =~ ^[0-9]+(\.[0-9]+)*([a-zA-Z0-9\.\-]*)?$ ]]; then
            # always check suffix matching (even when current_suffix is empty)
            local -r candidate_suffix=$(extract_version_suffix "$version")
            #echo "$version: candidate='$candidate_suffix', need '$current_suffix'" >&2

            # if current version has no suffix, only accept candidates with no suffix
            if [[ -z "$current_suffix" && -n "$candidate_suffix" ]]; then
                return 1
            fi
            
            # if current version has a suffix, reject candidates with no suffix
            if [[ -n "$current_suffix" && -z "$candidate_suffix" ]]; then
                return 1
            fi

            # if both have suffixes, check if they match
            if [[ -n "$current_suffix" && -n "$candidate_suffix" ]]; then
                # special handling for Ubuntu codenames (allow update between codenames)
                if is_ubuntu_codename "$current_suffix"; then
                    if ! is_ubuntu_codename "$candidate_suffix"; then
                        return 1
                    fi
                # for non-Ubuntu suffixes, require exact match
                else
                    if [[ "$current_suffix" != "$candidate_suffix" ]]; then
                        return 1
                    fi
                fi
            fi

            return 0
        fi
    fi
    
    return 1
}

#
# Generates a horizontal line for table borders based on column widths.
#
# @param $1   left border character (e.g., "┌", "├", "└")
# @param $2   middle border character (e.g., "┬", "┼", "┴")
# @param $3   right border character (e.g., "┐", "┤", "┘")
# @return horizontal line string for table borders
#
function generate_horizontal_line() {
    local -r left_char=$1
    local -r middle_char=$2
    local -r right_char=$3
    
    local line=""
    local -i i
    
    # Number column
    line+="${left_char}"
    for ((i=0; i<COL_NUM_WIDTH + 1; i++)); do
        line+="─"
    done
    line+="─${middle_char}"
    
    # Image column
    for ((i=0; i<COL_IMAGE_WIDTH + 1; i++)); do
        line+="─"
    done
    line+="─${middle_char}"
    
    # In Use column
    for ((i=0; i<COL_LOCAL_WIDTH + 1; i++)); do
        line+="─"
    done
    line+="─${middle_char}"
    
    # Latest column
    for ((i=0; i<COL_LATEST_WIDTH + 1; i++)); do
        line+="─"
    done
    line+="─${middle_char}"
    
    # Update column
    for ((i=0; i<COL_UPDATE_WIDTH + 1; i++)); do
        line+="─"
    done
    line+="─${right_char}"
    
    echo "$line"
}

#
# Prints table header with box-drawing characters and column titles.
#
function print_table_header() {
    # top line
    generate_horizontal_line "┌" "┬" "┐"

    # row number header is right-aligned
    printf "│ ${BOLD}%*s${COLOR_RESET} │ ${BOLD}%-*s${COLOR_RESET} │ ${BOLD}%-*s${COLOR_RESET} │ ${BOLD}%-*s${COLOR_RESET} │ ${BOLD}%-*s${COLOR_RESET} │\n" \
        "$COL_NUM_WIDTH" "$COL_NUM_LABEL" \
        "$COL_IMAGE_WIDTH" "$COL_IMAGE_LABEL" \
        "$COL_LOCAL_WIDTH" "$COL_LOCAL_LABEL" \
        "$COL_LATEST_WIDTH" "$COL_LATEST_LABEL" \
        "$COL_UPDATE_WIDTH" "$COL_UPDATE_LABEL"

    # separator_line
    generate_horizontal_line "├" "┼" "┤"
}

#
# Prints table footer with box-drawing characters.
#
function print_table_footer() {
    generate_horizontal_line "└" "┴" "┘"
}

#
# Formats output with box-drawing characters and configurable fixed column widths.
# Also used to print a separator row, in which case all the arguments are empty strings.
#
# @param $1   Docker image name
# @param $2   current version
# @param $3   latest version from DockerHub
# @param $4   update type (none/major/minor/patch/unknown)
#
function print_table_row() {
    local -r row_num=${1?Missing row_num}
    local -r image=${2?Missing image}
    local -r current=${3?Missing current}
    local -r latest=${4?Missing latest}
    local -r update_type=${5?Missing update_type}
    
    local update_label
    local update_color

    case "$update_type" in
        "major")
            update_color="$UPDATE_MAJOR_COLOR"
            update_label="$UPDATE_MAJOR_LABEL"
            ;;
        "minor")
            update_color="$UPDATE_MINOR_COLOR"
            update_label="$UPDATE_MINOR_LABEL"
            ;;
        "patch")
            update_color="$UPDATE_PATCH_COLOR"
            update_label="$UPDATE_PATCH_LABEL"
            ;;
        "unknown")
            update_color="$UPDATE_SPECIAL_COLOR"
            update_label="$UPDATE_SPECIAL_LABEL"
            ;;
        *)
            update_color="$UPDATE_NONE_COLOR"
            update_label="${UPDATE_NONE_LABEL}"
            ;;
    esac
    
    # truncate all fields to exact column widths
    local -r truncated_image="${image:0:$COL_IMAGE_WIDTH}"
    local -r truncated_current="${current:0:$COL_LOCAL_WIDTH}"
    local -r truncated_latest="${latest:0:$COL_LATEST_WIDTH}"
    local -r truncated_update="${update_label:0:$COL_UPDATE_WIDTH}"

    # highlight the changed part of the latest version (only for actual updates)
    local -i diff_start=-1
    if [[ "$update_type" != "none" ]]; then
        diff_start=$(find_version_diff_start "$current" "$latest")
    fi

    local latest_prefix="${truncated_latest}"
    local latest_diff=""
    if ((diff_start >= 0 && diff_start < COL_LATEST_WIDTH)); then
        latest_prefix="${truncated_latest:0:$diff_start}"
        latest_diff="${truncated_latest:diff_start}"
    fi

    # trailing padding keeps the column aligned despite the embedded ANSI sequences
    local -i latest_pad=$((COL_LATEST_WIDTH - ${#latest_prefix} - ${#latest_diff}))

    # the update type and the version diff share the same highlight style;
    # COLOR_HIGHLIGHT starts with an SGR reset, so bold must come after it
    local update_style="" # Update column label - every updated row
    local diff_style=""   # latest version diff - only when the diff is visible
    if [[ "$update_type" != "none" ]]; then
        update_style="${COLOR_HIGHLIGHT}${BOLD}"
        if [[ -n "$latest_diff" ]]; then
            diff_style="$update_style"
        fi
    fi

    # row number is right-aligned
    # the latest column is printed as prefix + highlighted diff + padding (never through a
    # width-padded %-spec, which would count the ANSI escape bytes and misalign the table)
    printf "│ ${update_color}%*s${COLOR_RESET} %s ${update_color}%-*s${COLOR_RESET} %s ${update_color}%-*s${COLOR_RESET} %s ${update_color}%s${diff_style}%s${COLOR_RESET}%*s %s ${update_color}${update_style}%-*s${COLOR_RESET} %s\n" \
        "$COL_NUM_WIDTH"    "$row_num"           "$V_BORDER" \
        "$COL_IMAGE_WIDTH"  "$truncated_image"   "$V_BORDER" \
        "$COL_LOCAL_WIDTH"  "$truncated_current" "$V_BORDER" \
        "$latest_prefix"    "$latest_diff"       "$latest_pad" "" "$V_BORDER" \
        "$COL_UPDATE_WIDTH" "$truncated_update"  "$V_BORDER"

    print_image_notes "$image"
}

#
# Fetches latest valid Docker image tag from DockerHub.
# Example:
#   "postgres" "16.4"     → "16.4" or newer (without a '-suffix')
#   "redis" "8.0.1-noble" → "8.0.1-noble" or newer (with the same or a different Ubuntu codename)
#   "mongo" "8.0.1"       → "8.0.1" or newer (without a '-suffix')
#
# @param $1   Docker image name (e.g., "postgres", "redis")
# @param $2   current version for suffix matching
# @return     latest valid tag (and $? = 0), or current version if API fails (and $? = 1)
#
function fetch_latest_docker_image_tag() {
    local -r image=${1?Missing image}
    local -r current_version=${2?Missing current_version}

    # extract suffix from current version for matching
    local -r current_suffix=$(extract_version_suffix "$current_version")

    # handle official images (library/ prefix)
    local api_image="$image"
    if [[ ! "$image" =~ "/" ]]; then
        api_image="library/$image"
    fi

    # try to fetch tags from DockerHub API
    local -r url="https://hub.docker.com/v2/repositories/${api_image}/tags?page_size=100"
    local latest_tag=""
    local -i attempt

    # make API request with retries
    for attempt in {1..3}; do
        #echo "Fetching '$image' from '$url'" >&2
        local response
        response=$(curl -s -w "\n%{http_code}" "$url" 2>/dev/null)

        local http_code
        http_code=$(echo "$response" | tail -n1)

        # remove last line because it's the HTTP code (see above)
        local body
        body=$(echo "$response" | sed '$d')

        if [[ "$http_code" == "200" ]]; then
            local all_tags
            # get all tags and filter for valid numeric versions only with matching suffix,
            # then re-assign the latest tag in a loop
            all_tags=$(echo "$body" | grep -oP '"name":\s*"\K[^"]+' | while read -r tag; do
                if is_comparable_version "$tag" "$current_suffix"; then
                    echo "$tag"
                fi
            done)

            # find the highest valid version
            if [[ -n "$all_tags" ]]; then
                latest_tag=$(echo "$all_tags" | sort -V | tail -n1)
            fi

            if [[ -n "$latest_tag" ]]; then
                echo "$latest_tag"
                return 0
            fi
        fi

        # too many requests
        if [[ "$http_code" == "429" ]]; then
            sleep "$SLEEP_IF_TOO_MANY_REQUESTS"
        fi
    done

    # if API fails, return current version as fallback
    echo "$current_version"
    return 1
}

#
# For the given image, prints IMAGES_ERRORS_MAP entries, then IMAGES_WARNINGS_MAP entries, then IMAGES_INFO_MAP entries.
#
# @param $1   prefix string (e.g., "│    │   ")
# @param $2   max. message width (for left-alignment)
# @param $3   color code (ANSI sequence)
# @param $4   icon
# @param $5   messages (newline-separated)
#
function print_notes_with_color() {
    local -r prefix=${1?Missing prefix}
    local -r max_width=${2?Missing max_width}
    local -r color=${3?Missing color}
    local -r icon=${4?Missing icon}
    local -r messages=${5?Missing messages}

    # Calculate available width in the image column for the message.
    # The prefix is "│    │   " and the icon follows immediately after.
    local -i icon_visual_width=${#icon}
    ((icon_visual_width++))
    # special extra-wide icon
    if [[ "$icon" =~ "❗" ]]; then
        ((icon_visual_width++))
    fi

    while IFS= read -r message; do
        echo -ne "${prefix}${color}${BOLD}${icon}${COLOR_RESET}${NOTE_COLOR}"
        print_raw_note "$icon_visual_width" "$message"
        echo -e "${COLOR_RESET}"
    done <<< "$messages"
}

#
# Prints a single message content with table borders (those not overlapped by the message).
#
# @param $1   icon visual width (calculated)
# @param $2   message to print
#
function print_raw_note() {
    local -ri icon_visual_width=${1?Missing prefix_with_icon_width}
    local -r message=${2?Missing message}

    # test cases:
    # no border
    #message=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
    # 1 border
    #message=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
    # 2 borders
    #message=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
    # 3 borders
    #message=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
    # 4 borders
    #message=aaaaaaaaaaaaaaaaaaaaaaaaaaaaa

    # Step #1: create empty table row template with all (empty) columns and borders.
    # Template structure: message area + borders and empty columns.
    local -r empty_row_template=$(printf '%*s%s%*s%s%*s%s%*s%s\n' \
        "$((COL_IMAGE_WIDTH - icon_visual_width))" "" \
        "$V_BORDER" \
        "$((COL_LOCAL_WIDTH + 2))" "" \
        "$V_BORDER" \
        "$((COL_LATEST_WIDTH + 2))" "" \
        "$V_BORDER" \
        "$((COL_UPDATE_WIDTH + 2))" "" \
        "$V_BORDER")

    # Step #2: place message over the template by overwriting characters.
    # The template starts from where the message area begins (after the icon).
    local -r remaining_template="${empty_row_template:${#message}}"
    # Step #3: interpret ANSI sequences.
    echo -ne "${message}${remaining_template}"
}

#
# For the given image, prints IMAGES_ERRORS_MAP entries, then IMAGES_WARNINGS_MAP entries, then IMAGES_INFO_MAP entries.
#
# @param $1   image name (the key for the above maps)
#
function print_image_notes() {
    local -r image=${1?Missing image}

    # content + borders
    local -r row_width=$((COL_NUM_WIDTH + COL_IMAGE_WIDTH + COL_LOCAL_WIDTH + COL_LATEST_WIDTH + COL_UPDATE_WIDTH + 6))
    # the first column (empty in this case) is the row number
    local -r prefix="│    │   "
    local -r max_width=$((row_width - ${#prefix} + 7))

    # display errors first
    if [[ -v IMAGES_ERRORS_MAP[$image] ]]; then
        print_notes_with_color "$prefix" "$max_width" "$COLOR_ERROR" "🛇 " "${IMAGES_ERRORS_MAP[$image]}"
    fi

    # then warnings
    if [[ -v IMAGES_WARNINGS_MAP[$image] ]]; then
        print_notes_with_color "$prefix" "$max_width" "$COLOR_WARN" "❗" "${IMAGES_WARNINGS_MAP[$image]}"
    fi

    # then infos
    if [[ -v IMAGES_INFO_MAP[$image] ]]; then
        print_notes_with_color "$prefix" "$max_width" "" "• " "${IMAGES_INFO_MAP[$image]}"
    fi
}

#
# Prints summary statistics and repository infos.
#
# @param $1   total number of images checked
# @param $2   total number of images with updates
# @param $3   number of major updates
# @param $4   number of minor updates
# @param $5   number of patch updates
# @param $6   number of special updates
#
function print_summary() {
    local -r total_images=${1?Missing total_images}
    local -r total_updates=${2?Missing total_updates}
    local -r major_updates=${3?Missing major_updates}
    local -r minor_updates=${4?Missing minor_updates}
    local -r patch_updates=${5?Missing patch_updates}
    local -r special_updates=${6?Missing special_updates}
    
    echo
    echo "Total images checked: $total_images"
    echo "Images with updates:  $total_updates"
    echo -e "  • $UPDATE_MAJOR_LABEL:   ${major_updates}"
    echo -e "  • $UPDATE_MINOR_LABEL:   ${minor_updates}"
    echo -e "  • $UPDATE_PATCH_LABEL:   ${patch_updates}"
    echo -e "  • $UPDATE_SPECIAL_LABEL: ${special_updates}"
    echo
}

#
# Main execution function that orchestrates the version checking process.
# Prints formatted table and summary statistics.
#
function main() {
    parse_args "$@"

    # run unit tests first - a broken version parser must never produce misleading version tables
    if ! run_version_function_tests; then
        log_error "Version function unit tests failed"
        if [[ -n "$JSON_OUTPUT" ]]; then
            emit_json_error "Version function unit tests failed"
        fi
        exit 1
    fi

    # exits if .env is missing
    if [[ ! -r "$INPUT_FILE" ]]; then
        log_error "File '$INPUT_FILE' does not exist or is not readable"
        if [[ -n "$JSON_OUTPUT" ]]; then
            emit_json_error "File '$INPUT_FILE' does not exist or is not readable"
        fi
        exit 1
    fi

    # parse file file to build Docker images array dynamically
    log_info "Parsing '$INPUT_FILE' for Docker images"
    parse_input_file "$INPUT_FILE"
    
    # convert associative array to indexed array for iteration
    declare -a DOCKER_IMAGES
    collect_docker_images DOCKER_IMAGES
    
    if [[ ${#DOCKER_IMAGES[@]} -eq 0 ]]; then
        log_error "No Docker images found"
        if [[ -n "$JSON_OUTPUT" ]]; then
            emit_json_error "No Docker images found"
        fi
        exit 1
    fi
    

    if [[ -z "$JSON_OUTPUT" ]]; then
        log_info "Checking ${#DOCKER_IMAGES[@]} Docker images on DockerHub (-h for help, --json for JSON output)"
        echo
        print_table_header
    else
        log_info "Checking ${#DOCKER_IMAGES[@]} Docker images on DockerHub (with JSON output)"
    fi

    local -i total_updates=0
    local -i major_updates=0
    local -i minor_updates=0
    local -i patch_updates=0
    local -i special_updates=0

    local -i row_num=1

    for image_info in "${DOCKER_IMAGES[@]}"; do
        # rate limiting delay
        if [ "$row_num" -gt 1 ] ; then
            sleep "$SLEEP_BETWEEN_IMAGE_REQUESTS"
        fi

        IFS=':' read -r image variable_name current_version <<< "$image_info"
        local latest_tag
        latest_tag=$(fetch_latest_docker_image_tag "$image" "$current_version")

        # fetch_latest_docker_image_tag returns 1 when it fell back to the current version
        local -i fetch_result=$?
        local fetch_failed="false"
        if [[ $fetch_result -ne 0 ]]; then
            fetch_failed="true"
        fi

        # compare versions
        local current_version_normalized
        current_version_normalized=$(normalize_version_for_comparison "$current_version")

        local latest_tag_normalized
        latest_tag_normalized=$(normalize_version_for_comparison "$latest_tag")

        local update_type
        update_type=$(detect_version_update "$current_version_normalized" "$latest_tag_normalized")

        # count updates
        if [[ "$update_type" != "none" ]]; then
            ((total_updates++))

          case "$update_type" in
              "major") ((major_updates++));;
              "minor") ((minor_updates++));;
              "patch") ((patch_updates++));;
              *) ((special_updates++));;
          esac
        fi

        if [[ -n "$JSON_OUTPUT" ]]; then
            IMAGE_ROWS_JSON+=("$(build_image_json_row \
                "$image" \
                "$variable_name" \
                "$current_version" \
                "$latest_tag" \
                "$update_type" \
                "$fetch_failed" \
                "${IMAGES_INFO_MAP[$image]:-}" \
                "${IMAGES_WARNINGS_MAP[$image]:-}" \
                "${IMAGES_ERRORS_MAP[$image]:-}")")
        else
            # separator_line - especially useful is previous image has notes
            if [ "$row_num" -gt 1 ]; then
                generate_horizontal_line "├" "┼" "┤"
            fi

            print_table_row "$row_num" "$image" "$current_version" "$latest_tag" "$update_type"
        fi
        ((row_num++))
    done
    
    if [[ -n "$JSON_OUTPUT" ]]; then
        emit_json_output IMAGE_ROWS_JSON "${#DOCKER_IMAGES[@]}" "$total_updates" "$major_updates" "$minor_updates" "$patch_updates" "$special_updates"
    else
        print_table_footer
        print_summary "${#DOCKER_IMAGES[@]}" "$total_updates" "$major_updates" "$minor_updates" "$patch_updates" "$special_updates"
    fi
}

main "$@"
