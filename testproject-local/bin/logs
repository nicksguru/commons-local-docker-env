#!/usr/bin/env bash
#
# Monitors Docker container logs in real time.
# If no arguments are passed, all the services are monitored (in this Docker Compose stack).
# If any arguments are passed, they are treated as space-separated service names to monitor.
#
set -e
DIR=$(dirname "$0")

# exits on non-existing file thanks to '-e'
. "$DIR/../../lib/functions.bash"
# exits if .env is missing
load_env_file

(cd "$DIR/.." &&
  ./docker-compose logs --tail 1024 -f "$@")
