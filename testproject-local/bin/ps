#!/usr/bin/env bash
#
# Displays Docker container processes.
# If no arguments are passed, all the services are listed (in this Docker Compose stack).
# If any arguments are passed, they are treated as space-separated service names to list.
#
set -e
DIR=$(dirname "$0")

# exits on non-existing file thanks to '-e'
. "$DIR/../../lib/functions.bash"
# exits if .env is missing
load_env_file

(cd "$DIR/.." &&
  ./docker-compose ps "$@")
