#!/usr/bin/env bash
#
# Stops services listed in COMPOSE_PROFILES (see '.env').
# If any arguments are passed, they are treated as space-separated service names to stop.
#
# WARNING: passing '-v' or '--volumes' removes all project's Docker volumes
# without any confirmation!
#
set -e
DIR=$(dirname "$0")
# exits on non-existing file thanks to '-e'
. "$DIR/../../lib/functions.bash"

# exits if .env is missing
load_env_file

(cd "$DIR/.." &&
  ./docker-compose down --remove-orphans "$@")
